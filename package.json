{
  "name": "a-palavra-em-ordem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:account": "playwright test --config playwright.account.config.ts",
    "check:media": "node scripts/check-media.mjs",
    "media:import": "node scripts/import-media.mjs",
    "media:pilgrimage": "node scripts/import-pilgrimage-maps.mjs",
    "config:sync": "node -e \"const f=require('fs');f.copyFileSync('config/produtos-plataforma.json','supabase/functions/_shared/produtos-plataforma.json');f.copyFileSync('content/oferta.json','supabase/functions/_shared/oferta.json');f.copyFileSync('config/checkout.json','supabase/functions/_shared/checkout.json')\"",
    "content:check": "node scripts/content/check.mjs",
    "content:review": "node scripts/content/review.mjs",
    "content:publish": "node scripts/content/publish.mjs",
    "content:upload": "node scripts/content/upload.mjs",
    "print:export": "node scripts/print-export.mjs",
    "print:upload": "node scripts/print-upload.mjs",
    "audio:generate": "node scripts/audio/generate.mjs",
    "audio:upload": "node scripts/audio/upload.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "howler": "^2.2.4",
    "lenis": "^1.3.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/howler": "^2.2.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
