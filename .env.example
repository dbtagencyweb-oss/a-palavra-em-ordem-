# Copy to .env.local and fill in (see docs/04-conta-e-venda.md). Never commit .env.local.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Hotmart → produto "Acesso Fundador" → link de checkout (ex.: https://pay.hotmart.com/XXXXXXXX)
VITE_HOTMART_CHECKOUT_URL=

# Landing page (/lp/)
# Where "começar os 7 dias grátis" sends people (default: same site as the landing page).
VITE_APP_URL=
# Meta Pixel id (Gerenciador de Eventos). Empty = no pixel.
VITE_META_PIXEL_ID=

# Lembretes por push (docs/04, seção 11). Chave pública VAPID (a privada vai só nos secrets da função).
VITE_VAPID_PUBLIC_KEY=
